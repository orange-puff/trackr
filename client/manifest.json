{
  "manifest_version": 2,
  "name": "Sample Firefox Extension",
  "version": "1.0.0",
  "description": "A basic Firefox extension boilerplate with sample HTML",

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Sample Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },


  "web_accessible_resources": [
    "popup.html"
  ]
}